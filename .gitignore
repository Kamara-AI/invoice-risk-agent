# ==============================================================================
# Invoice Risk Intelligence Agent — .gitignore
# ==============================================================================

# Environment & secrets — NEVER commit these
.env
credentials.json
token.json

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Pytest cache
.pytest_cache/
.cache/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# LangChain / LangSmith local cache
.langchain/

# PDF invoice files — may contain PII
*.pdf
# Exception: synthetic eval fixtures contain no real data and are safe to commit
!evals/fixtures/*.pdf

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/

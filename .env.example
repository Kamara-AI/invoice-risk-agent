# ==============================================================================
# Invoice Risk Intelligence Agent — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM — OpenAI
# Used by the LLM scoring node via langchain-openai.
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# LangSmith — Observability & Tracing
# Enables full trace visibility for every agent run in LangSmith.
# LANGCHAIN_TRACING_V2 must be "true" (string) for the SDK to pick it up.
# ------------------------------------------------------------------------------
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=invoice-risk-agent

# ------------------------------------------------------------------------------
# Gmail API — Invoice Ingestion
# OAuth2 credentials for reading invoices from the Gmail inbox.
# Obtain from Google Cloud Console → APIs & Services → Credentials.
# GMAIL_REFRESH_TOKEN is obtained after the initial OAuth2 consent flow.
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_USER_EMAIL=invoices@yourcompany.com

# ------------------------------------------------------------------------------
# Slack API — Human Review & Alerts
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...).
# SLACK_SIGNING_SECRET: Used to verify incoming webhook payloads from Slack.
# SLACK_REVIEW_CHANNEL_ID: Channel where human review requests are posted.
# SLACK_ALERT_CHANNEL_ID: Channel where auto-block and system alerts are posted.
# ------------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_REVIEW_CHANNEL_ID=C0XXXXXXXXX
SLACK_ALERT_CHANNEL_ID=C0YYYYYYYYY

# ------------------------------------------------------------------------------
# Stripe — Payment Fingerprinting & Radar Score
# Used by gate_stripe to detect bank account substitution (BEC fraud).
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# OFAC Sanctions Screening
# OFAC_API_KEY: Your key for the OFAC API service.
# OFAC_API_BASE_URL: Base URL for the OFAC API (v4 endpoint).
# ------------------------------------------------------------------------------
OFAC_API_KEY=your-ofac-api-key
OFAC_API_BASE_URL=https://api.ofac-api.com/v4

# ------------------------------------------------------------------------------
# Supabase — Persistent Storage
# SUPABASE_URL: Your project's REST endpoint (https://<project>.supabase.co).
# SUPABASE_KEY: Service role key — grants full DB access, keep secret.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Application
# APP_ENV: "development" | "staging" | "production"
# APP_HOST / APP_PORT: Uvicorn bind address.
# ------------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
